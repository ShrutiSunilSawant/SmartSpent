# ============================================================
# AI Financial Copilot - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Run the app once and JWT_SECRET will be auto-generated.
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///./financial_copilot.db

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
# Alternatives: llama3, qwen2, mistral, qwen2.5:3b

# --- OCR ---
# Leave blank to auto-detect via PATH (recommended on Mac/Linux)
# TESSERACT_PATH=/usr/bin/tesseract
# Windows: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- ChromaDB (Vector Memory) ---
CHROMA_PERSIST_DIR=./chroma_db

# --- App Settings ---
APP_NAME=AI Financial Copilot
DEBUG=false
LOG_LEVEL=INFO

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- JWT (leave blank — auto-generated and saved on first run) ---
JWT_SECRET=
